# ─────────────────────────────────────────────────────────────────────────────
# TapGuard runtime secrets — TEMPLATE (committed to git)
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# How to get each value:
#   SMTP_*              → Maileroo dashboard (https://maileroo.com)
#   ONESIGNAL_*         → OneSignal dashboard → Settings → Keys & IDs
#   FIREBASE_*_API_KEY  → Firebase Console → Project Settings → General
#                         → Your apps → SDK setup and configuration
#   FIREBASE_*_APP_ID   → Same place as the API key
#
# After rotating, paste the new values into your local `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Maileroo SMTP (email OTP) ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=TapGuard

# ─── OneSignal (push notifications) ──────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ─── Firebase Web ────────────────────────────────────────────────────────────
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=tapguard-0.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=tapguard-0.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_PROJECT_ID=tapguard-0
FIREBASE_WEB_MEASUREMENT_ID=

# ─── Firebase Android ────────────────────────────────────────────────────────
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_STORAGE_BUCKET=tapguard-0.firebasestorage.app
FIREBASE_ANDROID_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_PROJECT_ID=tapguard-0

# ─── Firebase iOS ────────────────────────────────────────────────────────────
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_STORAGE_BUCKET=tapguard-0.firebasestorage.app
FIREBASE_IOS_MESSAGING_SENDER_ID=
FIREBASE_IOS_PROJECT_ID=tapguard-0
FIREBASE_IOS_BUNDLE_ID=com.example.tapguard

# ─── Firebase macOS ──────────────────────────────────────────────────────────
FIREBASE_MACOS_API_KEY=
FIREBASE_MACOS_APP_ID=
FIREBASE_MACOS_STORAGE_BUCKET=tapguard-0.firebasestorage.app
FIREBASE_MACOS_MESSAGING_SENDER_ID=
FIREBASE_MACOS_PROJECT_ID=tapguard-0
FIREBASE_MACOS_BUNDLE_ID=com.example.tapguard

# ─── Firebase Windows ────────────────────────────────────────────────────────
FIREBASE_WINDOWS_API_KEY=
FIREBASE_WINDOWS_APP_ID=
FIREBASE_WINDOWS_AUTH_DOMAIN=tapguard-0.firebaseapp.com
FIREBASE_WINDOWS_STORAGE_BUCKET=tapguard-0.firebasestorage.app
FIREBASE_WINDOWS_MESSAGING_SENDER_ID=
FIREBASE_WINDOWS_PROJECT_ID=tapguard-0
FIREBASE_WINDOWS_MEASUREMENT_ID=
